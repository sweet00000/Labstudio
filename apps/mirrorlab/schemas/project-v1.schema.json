{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mirrorlab project v1",
  "type": "object",
  "required": [
    "schema",
    "schemaVersion",
    "units",
    "parameters"
  ],
  "properties": {
    "schema": {
      "const": "mirrorlab.project"
    },
    "schemaVersion": {
      "const": 1
    },
    "units": {
      "const": "mm"
    },
    "solver": {
      "type": "string"
    },
    "parameters": {
      "type": "object",
      "properties": {
        "layout": {
          "type": "string",
          "enum": [
            "single",
            "birdbath"
          ],
          "default": "birdbath"
        },
        "surface": {
          "type": "string",
          "enum": [
            "flat",
            "sphere",
            "paraboloid"
          ],
          "default": "sphere"
        },
        "source": {
          "type": "string",
          "enum": [
            "point",
            "grid",
            "parallel"
          ],
          "default": "grid"
        },
        "radius": {
          "type": "number",
          "minimum": 30,
          "maximum": 300,
          "default": 100
        },
        "aperture": {
          "type": "number",
          "minimum": 4,
          "maximum": 70,
          "default": 36
        },
        "distance": {
          "type": "number",
          "minimum": 20,
          "maximum": 180,
          "default": 50
        },
        "pitch": {
          "type": "number",
          "minimum": -20,
          "maximum": 20,
          "default": 0
        },
        "yaw": {
          "type": "number",
          "minimum": -20,
          "maximum": 20,
          "default": 0
        },
        "reflectivity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.92
        },
        "cone": {
          "type": "number",
          "minimum": 2,
          "maximum": 55,
          "default": 24
        },
        "width": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 24,
          "default": 8
        },
        "height": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 18,
          "default": 4.5
        },
        "beamRadius": {
          "type": "number",
          "minimum": 2,
          "maximum": 45,
          "default": 22
        },
        "samples": {
          "type": "integer",
          "minimum": 64,
          "maximum": 4096,
          "default": 1024
        },
        "splitterZ": {
          "type": "number",
          "minimum": 5,
          "maximum": 45,
          "default": 22
        },
        "splitterSize": {
          "type": "number",
          "minimum": 8,
          "maximum": 100,
          "default": 46
        },
        "splitterR": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "detectorZ": {
          "type": "number",
          "minimum": 25,
          "maximum": 220,
          "default": 72
        },
        "pupil": {
          "type": "number",
          "minimum": 1,
          "maximum": 12,
          "default": 5
        },
        "eyeX": {
          "type": "number",
          "minimum": -25,
          "maximum": 25,
          "default": 0
        },
        "eyeY": {
          "type": "number",
          "minimum": -25,
          "maximum": 25,
          "default": 0
        }
      },
      "description": "Missing known parameters use defaults. Additional keys are ignored by v0.1. Geometric cross-field constraints are enforced by validate() in physics.js."
    }
  }
}
